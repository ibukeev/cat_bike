{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-package.schema.json",
  "title": "Cat-head right rear tube service route tooling package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package_id",
    "iteration_identity",
    "state",
    "authority",
    "route",
    "inputs",
    "authoritative_frame",
    "dimensions",
    "future_stages",
    "hard_gates",
    "focused_regressions",
    "new_output_preflight",
    "tooling",
    "prohibited",
    "approval"
  ],
  "properties": {
    "$schema": {"const": "route-package.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "right-rear-tube-service-route-tooling-v1"},
    "iteration_identity": {"const": "right-rear-tube-service-route-tooling-v1"},
    "state": {
      "const": "TOOLING_ONLY__SCHEMA_HASH_NEW_OUTPUT_PREFLIGHT__AWAITING_HUMAN_VISUAL_ROUTE_APPROVAL"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_effect",
        "geometry_run_authorized",
        "candidate_authorized",
        "production_mutation_authorized",
        "integration_authorized",
        "export_authorized",
        "slice_authorized",
        "promotion_authorized"
      ],
      "properties": {
        "allowed_effect": {
          "const": "additive tooling source plus one textual JSON preflight report"
        },
        "geometry_run_authorized": {"const": false},
        "candidate_authorized": {"const": false},
        "production_mutation_authorized": {"const": false},
        "integration_authorized": {"const": false},
        "export_authorized": {"const": false},
        "slice_authorized": {"const": false},
        "promotion_authorized": {"const": false}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_route",
        "axis_policy",
        "ordered_actions",
        "alternates_in_scope",
        "reason"
      ],
      "properties": {
        "selected_route": {
          "const": "KEEP_ACCEPTED_M2_AXIS__LOCAL_UPPER_C001_PASSAGE__RIGHT_REAR_PORT__R1_OUTBOARD_SERVICE_CAP"
        },
        "axis_policy": {"const": "preserve accepted M2 axis, origin, roll, socket, and lower target exactly"},
        "ordered_actions": {
          "type": "array",
          "prefixItems": [
            {"const": "isolated upper-C001 exact tube-sweep passage"},
            {"const": "right rear printed-shell port; metal backplate remains uncut"},
            {"const": "R1 outboard C002 service window"},
            {"const": "separately retained R1 outboard service cap"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "alternates_in_scope": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_baseline_manifest",
        "approved_baseline_assembly",
        "accepted_c002_candidate",
        "m2_interface",
        "m2_human_adjudication",
        "rear_path_review_contract",
        "rear_path_review_report",
        "rear_path_review_fcstd",
        "service_cap_numeric_proposal",
        "gate9_service_constraints"
      ],
      "properties": {
        "approved_baseline_manifest": {"$ref": "#/$defs/file_ref"},
        "approved_baseline_assembly": {"$ref": "#/$defs/file_ref"},
        "accepted_c002_candidate": {"$ref": "#/$defs/file_ref"},
        "m2_interface": {"$ref": "#/$defs/file_ref"},
        "m2_human_adjudication": {"$ref": "#/$defs/file_ref"},
        "rear_path_review_contract": {"$ref": "#/$defs/file_ref"},
        "rear_path_review_report": {"$ref": "#/$defs/file_ref"},
        "rear_path_review_fcstd": {"$ref": "#/$defs/file_ref"},
        "service_cap_numeric_proposal": {"$ref": "#/$defs/file_ref"},
        "gate9_service_constraints": {"$ref": "#/$defs/file_ref"}
      }
    },
    "authoritative_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_head_mm", "t_axis", "u_axis", "v_axis", "handedness", "lower_target_head_mm"],
      "properties": {
        "origin_head_mm": {"$ref": "#/$defs/vector3"},
        "t_axis": {"$ref": "#/$defs/vector3"},
        "u_axis": {"$ref": "#/$defs/vector3"},
        "v_axis": {"$ref": "#/$defs/vector3"},
        "handedness": {"const": "u_cross_v_equals_t"},
        "lower_target_head_mm": {"$ref": "#/$defs/vector3"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rail", "upper_c001_obstruction", "rear_port", "r1_window", "service_cap", "rigid_pair"],
      "properties": {
        "rail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["physical_across_flats_mm", "clearance_sweep_across_flats_mm", "socket_across_flats_mm", "finished_length_mm", "insertion_travel_mm"],
          "properties": {
            "physical_across_flats_mm": {"type": "number"},
            "clearance_sweep_across_flats_mm": {"type": "number"},
            "socket_across_flats_mm": {"type": "number"},
            "finished_length_mm": {"type": "number"},
            "insertion_travel_mm": {"type": "number"}
          }
        },
        "upper_c001_obstruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "path_common_volume_mm3", "seated_common_volume_mm3", "entry_common_volume_mm3", "common_bounds_min_head_mm", "common_bounds_max_head_mm", "cut_policy"],
          "properties": {
            "owner": {"const": "RETAINED_RIGHT_UPPER_C001_V34"},
            "path_common_volume_mm3": {"type": "number"},
            "seated_common_volume_mm3": {"type": "number"},
            "entry_common_volume_mm3": {"type": "number"},
            "common_bounds_min_head_mm": {"$ref": "#/$defs/vector3"},
            "common_bounds_max_head_mm": {"$ref": "#/$defs/vector3"},
            "cut_policy": {"const": "target owner intersect exact 20.05 mm accepted-axis sweep only"}
          }
        },
        "rear_port": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rear_plane_axis_station_t_mm", "rear_plane_axis_point_head_mm", "projected_x_min_mm", "projected_x_max_mm", "projected_v_min_mm", "projected_v_max_mm", "minimum_x_span_mm", "minimum_v_span_mm", "metal_backplate_cut_allowed"],
          "properties": {
            "rear_plane_axis_station_t_mm": {"type": "number"},
            "rear_plane_axis_point_head_mm": {"$ref": "#/$defs/vector3"},
            "projected_x_min_mm": {"type": "number"},
            "projected_x_max_mm": {"type": "number"},
            "projected_v_min_mm": {"type": "number"},
            "projected_v_max_mm": {"type": "number"},
            "minimum_x_span_mm": {"type": "number"},
            "minimum_v_span_mm": {"type": "number"},
            "metal_backplate_cut_allowed": {"const": false}
          }
        },
        "r1_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_owner", "preview_clearance_mm", "window_t_span_mm", "window_v_span_mm", "outboard_wall_breakthrough_mm", "accepted_c002_common_volume_mm3"],
          "properties": {
            "target_owner": {"const": "RETAINED_RIGHT_UPPER_C002_V34"},
            "preview_clearance_mm": {"type": "number"},
            "window_t_span_mm": {"type": "number"},
            "window_v_span_mm": {"type": "number"},
            "outboard_wall_breakthrough_mm": {"type": "number"},
            "accepted_c002_common_volume_mm3": {"type": "number"}
          }
        },
        "service_cap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constraint_status", "tongue_clearance_mm", "receiver_clearance_mm", "cover_thickness_mm", "axis_end_clearance_mm", "fastener_quantity", "fastener_nominal", "m3_clearance_diameter_mm", "insert_pocket_diameter_mm", "insert_pocket_depth_mm", "axis_stations_from_mouth_mm", "cross_section_stations_mm", "head_envelope_diameter_mm", "head_envelope_thickness_mm", "tool_approach_diameter_mm", "tool_approach_length_mm"],
          "properties": {
            "constraint_status": {"const": "gates only; cap owner and geometry remain unapproved"},
            "tongue_clearance_mm": {"type": "number"},
            "receiver_clearance_mm": {"type": "number"},
            "cover_thickness_mm": {"type": "number"},
            "axis_end_clearance_mm": {"type": "number"},
            "fastener_quantity": {"type": "integer"},
            "fastener_nominal": {"type": "string", "minLength": 1},
            "m3_clearance_diameter_mm": {"type": "number"},
            "insert_pocket_diameter_mm": {"type": "number"},
            "insert_pocket_depth_mm": {"type": "number"},
            "axis_stations_from_mouth_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "cross_section_stations_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "head_envelope_diameter_mm": {"type": "number"},
            "head_envelope_thickness_mm": {"type": "number"},
            "tool_approach_diameter_mm": {"type": "number"},
            "tool_approach_length_mm": {"type": "number"}
          }
        },
        "rigid_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_to_common_axis_angle_deg", "lateral_drift_over_30_mm", "available_socket_clearance_each_side_mm", "excess_lateral_drift_at_30_mm", "common_motion_limit_mm", "blind_full_insertion_pass"],
          "properties": {
            "accepted_to_common_axis_angle_deg": {"type": "number"},
            "lateral_drift_over_30_mm": {"type": "number"},
            "available_socket_clearance_each_side_mm": {"type": "number"},
            "excess_lateral_drift_at_30_mm": {"type": "number"},
            "common_motion_limit_mm": {"type": "number"},
            "blind_full_insertion_pass": {"const": false}
          }
        }
      }
    },
    "future_stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage"},
      "minItems": 4,
      "maxItems": 4
    },
    "hard_gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"},
      "minItems": 12
    },
    "focused_regressions": {
      "type": "array",
      "items": {"$ref": "#/$defs/regression"},
      "minItems": 10
    },
    "new_output_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_candidate_directories", "tooling_report", "all_must_be_absent_before_preflight"],
      "properties": {
        "future_candidate_directories": {
          "type": "array",
          "items": {"$ref": "#/$defs/repository_path"},
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "tooling_report": {"$ref": "#/$defs/repository_path"},
        "all_must_be_absent_before_preflight": {"const": true}
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_files", "preflight_command", "geometry_modules_present", "freecad_import_permitted"],
      "properties": {
        "package_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/file_ref"},
          "minItems": 5,
          "uniqueItems": true
        },
        "preflight_command": {"type": "string", "minLength": 1},
        "geometry_modules_present": {"const": false},
        "freecad_import_permitted": {"const": false}
      }
    },
    "prohibited": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 12,
      "uniqueItems": true
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope_if_given", "command_template", "does_not_authorize"],
      "properties": {
        "status": {"const": "PENDING_HUMAN_VISUAL_ROUTE_APPROVAL"},
        "scope_if_given": {"const": "authorize drafting one future stage contract at a time; authorize no geometry run"},
        "command_template": {"type": "string", "pattern": "\\{contract_sha256\\}"},
        "does_not_authorize": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 6,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "iteration_id", "status", "target_owner", "owner_resolution", "mutation_kind", "depends_on", "candidate_output_directory", "candidate_enabled", "run_authorized", "intent", "entry_gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 4},
        "iteration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
        "status": {
          "enum": [
            "BLOCKED_PENDING_ROUTE_APPROVAL",
            "BLOCKED_PENDING_ROUTE_APPROVAL_AND_OWNER_SELECTION",
            "BLOCKED_PENDING_PRIOR_STAGE_ACCEPTANCE",
            "BLOCKED_PENDING_PRIOR_STAGE_ACCEPTANCE_AND_OWNER_CONTRACT"
          ]
        },
        "target_owner": {"type": ["string", "null"]},
        "owner_resolution": {"enum": ["RESOLVED_SINGLE_OWNER", "UNRESOLVED_HARD_HOLD"]},
        "mutation_kind": {"enum": ["boolean_cut", "add_feature"]},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_output_directory": {"$ref": "#/$defs/repository_path"},
        "candidate_enabled": {"const": false},
        "run_authorized": {"const": false},
        "intent": {"type": "string", "minLength": 1},
        "entry_gates": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "scope", "requirement", "pass_condition", "blocking"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^G[0-9]{2}_[A-Z0-9_]+$"},
        "scope": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "pass_condition": {"type": "string", "minLength": 1},
        "blocking": {"const": true}
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regression_id", "source", "assertion", "expected"],
      "properties": {
        "regression_id": {"type": "string", "pattern": "^R[0-9]{2}_[A-Z0-9_]+$"},
        "source": {"type": "string", "minLength": 1},
        "assertion": {"type": "string", "minLength": 1},
        "expected": {}
      }
    }
  }
}

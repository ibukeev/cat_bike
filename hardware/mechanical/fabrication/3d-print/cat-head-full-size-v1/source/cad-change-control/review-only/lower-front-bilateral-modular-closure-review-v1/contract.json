  "decision": {
    "objective": "Finish a modular bilateral lower-front review with clean opaque seams, separately editable translucent inserts and lower attachments, and a closed translucent mouth.",
    "source_policy": "Use the accepted V4 front-owner cleanup, the approved V5 ledge as a separate proposal, canonical V34 upper context, and the existing Gate8 insert assets without mutating any source.",
    "modularity": [
      "Each opaque owner remains a separate Part::Feature.",
      "Every mirrored owner remains a separate Part::Feature.",
      "Each closed connected translucent STL component remains separately selectable.",
      "The two mouth facets, center seam seal, each panel flange, each head flange, and each fastener reference remain separate objects.",
      "No production fusion, shell replacement, canonical overwrite, STL export, slicing, or print release."
    ],
    "opaque_ownership_resolution": {
      "bilateral_seam": "Clip the right lower review owners at world X=0, then mirror those clean owners to create the left side.",
      "lower_upper_seam": "Canonical V34 upper owners retain ownership; subtract only their positive-common volumes from lower review-owner copies.",
      "aggregate_display_policy": "Exclude the duplicate aggregate RETAINED_RIGHT_UPPER_V34 display object; retain the individually named C-owner objects.",
      "source_mutation": false
    },
    "translucent_ownership_resolution": {
      "policy": "In review copies only, classify each exact opaque-head intersection solid by its center against the pinned Gate8 attachment-radius zones; subtract only rejected intersection solids and leave allowed-only components unchanged.",
      "source_stl_mutation": false,
      "component_fusion": false,
      "clearance_classification": "zero positive common outside declared attachment zones"
    }
  },
